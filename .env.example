# Replace the example password with a unique local secret before starting Docker.
POSTGRES_DB=cashflow
POSTGRES_USER=cashflow
POSTGRES_PASSWORD=replace-with-random-local-password
POSTGRES_PORT=5432
DATABASE_URL="postgresql://cashflow:replace-with-random-local-password@127.0.0.1:5432/cashflow?schema=public"
PORT=3001
CLIENT_ORIGIN="http://127.0.0.1:5173"
SESSION_SECRET=replace-with-at-least-32-random-characters
