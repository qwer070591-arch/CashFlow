{
  "name": "cashflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "lint": "eslint client/src client/tests server/src server/tests scripts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:check-config": "node scripts/check-db-env.mjs",
    "predb:up": "npm run db:check-config",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:restart": "docker compose restart postgres",
    "db:ps": "docker compose ps",
    "db:logs": "docker compose logs --tail=100 postgres",
    "db:status": "npm run db:status -w server",
    "db:validate": "npm run db:validate -w server",
    "db:generate": "npm run db:generate -w server",
    "predb:migrate": "npm run db:check-config",
    "db:migrate": "npm run db:migrate -w server"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "concurrently": "9.2.5",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
